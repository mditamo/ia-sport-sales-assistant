# Modelo compatible con la API de OpenAI (OpenAI, LM Studio u otro proveedor)
OPENAI_API_BASE=http://127.0.0.1:1234/v1
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=qwen2.5-7b-instruct

# Modelo de embeddings
RAG_EMBEDDING_MODEL= "intfloat/multilingual-e5-base"

# Carpeta del vector store
PERSIST_DIRECTORY=./chroma_db

# Carpeta de datos de MCP y documentos funcionales
MCP_DATA_DIR=./data/mcp
DOC_FUNCIONAL_DATA_DIR=./data/doc_funcional

# Carpeta de logs
LOGS_DIR=./logs

# Observabilidad con LangSmith
LANGSMITH_API_KEY=replace-with-your-langsmith-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=ai-sport-sales
